/*--------------------------------------------------
    Processamento dos JSONs
--------------------------------------------------*/
Map parseJSON(String jsonFile, String description) {
    List<String> text = [
        "Arquivo JSON ${description}"
    ]
    if (fileExists(file: jsonFile)) {
        text << 'Arquivo encontrado'
        Map jsonParsed = readJSON file: jsonFile
        if (jsonParsed) {
            text << 'Arquivo parseado'
            echo text.join('\n')
            return jsonParsed
        } else {
            text << 'Arquivo inválido ou vazio!'
            echo text.join('\n')
            error "Arquivo JSON ${description} inválido ou vazio"
        }
    } else {
        text << 'Arquivo não encontrado'
        echo text.join('\n')
        error "Arquivo JSON ${description} não encontrado"
    }
}


/*--------------------------------------------------
    Validação do encoding do script
--------------------------------------------------*/
void validateScriptEncoding(String script) {
    String cmdCharset
    String retCharset
    String cmdBOM
    String retBOM

    //Para utilização do uchardet depende da instalação
    //cmdCharset = "uchardet ${script}"
    //retCharset = sh(script: comando, returnStdout: true).trim().toUpperCase()

    //Comando para retorno do charset
    cmdCharset = "file -bi ${script} | awk -F'charset=' '{print \$2}'"
    retCharset = sh(script: cmdCharset, returnStdout: true).trim().toUpperCase()
    // ASCII é um subset do UTF-8 e apenas indica um arquivo sem acentos ou caracteres especias
    if (retCharset in ['US-ASCII', 'UTF-8']) {
        // Se o encoding é válido, testa o BOM

        // Comando para retorno do BOM
        cmdBOM = """head -c 3 ${script} | hexdump -ve '/1 "%02x"' | awk '{print (\$0 == "efbbbf" ? "yes" : "no")}'"""
        retBOM = sh(script: cmdBOM, returnStdout: true).trim().toUpperCase()
        if (retBOM == 'YES') {
            echo status('E', "Encoding válido: ${retCharset} porém script possui BOM")
            error status('E', "Script ${script} programado para deploy com encoding inválido")
        } else {
            echo status('S', "Encoding válido: ${retCharset}")
        }
    } else {
        echo status('E', "Encoding inválido: ${retCharset}")
        error status('E', "Script ${script} programado para deploy com encoding inválido")
    }
}


/*--------------------------------------------------
    Verificação de caracteres inválidos no script
--------------------------------------------------*/
void validateScriptCharacters(String script) {
    def httpResponse
    List<String> texto = []

    try {
        // Chama a API de validação
        httpResponse = httpRequest url: 'http://devops.semars.intra.rs.gov.br/validatorscriptsql/ValidatorFile',
                                    httpMode: 'POST',
                                    quiet: true,
                                    acceptType: 'APPLICATION_JSON',
                                    multipartName: 'file',
                                    uploadFile: script,
                                    validResponseCodes: '100:599',
                                    consoleLogResponseBody: true,
                                    timeout: 20

    } catch (Exception e) {
        error status('E', "Chamada da API de validação dos scripts não foi feita:\n${e.getMessage()}")
    }

    if (httpResponse.status == 200) {
        texto = [
            text("[SUCESSO] Validação dos caracteres do script com sucesso")
        ]
    } else {
        texto = [
            text("[ERRO] Validação dos caracteres do script com erro")
        ]
    }
    texto << text("Status: ${httpResponse.status}")
    texto << text('')
    texto << text('Resposta:')
    if (httpResponse.content != null) {
        try {
            JsonOutput.prettyPrint(httpResponse.content).split('\n').each { line ->
                texto << text(line)
            }
        } catch (Exception ignored) {
            texto << text("    ${httpResponse.content}")
        }
        texto << text('')
    }
    if (httpResponse.status == 200) {
        texto << text("API executou e retornou com sucesso")
    } else {
        texto << text("API executou e retornou com erro")
    }
    echo writeText(texto)

    if (httpResponse.status != 200) {
        error status('E', "Script ${script} com caracteres inválidos")
    }
}


/*--------------------------------------------------
    Execução de script no SQL*Plus
--------------------------------------------------*/
String runScript(String script, String connection, String objectType = '') {
    String config
    String comando
    String input
    String retorno

    // Converte o charset do script
    //sh "iconv -f UTF-8 -t ISO-8859-1 ${script} -o ${script}.new"

    config = 'export LD_LIBRARY_PATH=/opt/oracle/instantclient_21_10\n' +
                'export PATH=$LD_LIBRARY_PATH:$PATH\n' +
                //'export NLS_LANG=AMERICAN_AMERICA.WE8ISO8859P1\n' +
                'export NLS_LANG=AMERICAN_AMERICA.AL32UTF8\n' +
                'export LANG=en_US.UTF-8\n' + // Config do shell
                'export LC_ALL=en_US.UTF-8\n' // Config do shell

    if (!objectType) {
        comando = config + """echo "@${script}" | sqlplus "${connection}";\n"""
    } else {
        // Se o tipo do objeto estiver na lista de check, depois do script roda o "show errors"
        if (objectType in checkErrors) {
            input = '(echo "@' + script + '"; echo "show errors")'
        } else {
            input = 'echo "@' + script + '"'
        }
        comando = config + """${input} | sqlplus "${connection}";\n"""
    }

    try {
        retorno = sh(script: comando, returnStdout: true)
    } catch (Exception e) {
        // Erro crítico na execução do comando: coloca na console e aborta
        echo status('E', "Falha rodando script no SQL*Plus:\n${e.getMessage()}")
        error status('E', "Falha rodando o comando")
    }
    return retorno
}


/*--------------------------------------------------
    Inclui a linha da console no log
--------------------------------------------------*/
String line(String line) {
    if (!line) {
        return
    }
    addLogLine(line)
    return line
}


/*--------------------------------------------------
    Inclui a linha do texto (grupo) da console no log
--------------------------------------------------*/
String text(String line) {
    if (!line) {
        return ''
    }
    addLogTextLine(line)
    return line
}


/*--------------------------------------------------
    Adiciona o texto escrito na console no buffer do log
--------------------------------------------------*/
String writeText(List text) {
    if (!text) {
        return
    }
    flushLogText()
    return text.join('\n')
}


/*--------------------------------------------------
    Inclui o texto escrito na console com o identificador do status no buffer do log
--------------------------------------------------*/
String status(String status, String line) {
    /* Parâmetros:
        status -> 'S' para 'SUCESSO' / 'A' para 'ALERTA' / 'E' para 'ERRO'
        line   -> Texto da linha a ser colocado na console
    */
    if (!line) {
        return
    }
    String message

    switch (status.toUpperCase()[0]) {
        case 'S':
            message = "[SUCESSO]: ${line}"
            break
        case 'A':
            message = "[ALERTA]: ${line}"
            break
        case 'E':
            message = "[ERRO]: ${line}"
            break
        default:
            message = line
            break
    }

    addLogLine(message)
    return message
}


/*--------------------------------------------------
    Starter do build
--------------------------------------------------*/
String getBuildStarter() {
    List causes = currentBuild.rawBuild.getCauses()
    List<String> result = []

    for (c in causes) {
        switch (true) {
            case c instanceof hudson.model.Cause$UserIdCause:
                result << c.getUserName()
                break
            case c instanceof hudson.triggers.TimerTrigger$TimerTriggerCause:
                result << 'Agendado (cron)'
                break
            case c instanceof hudson.triggers.SCMTrigger$SCMTriggerCause:
                result << 'SCM (commit/polling)'
                break
            case c instanceof hudson.model.Cause$UpstreamCause:
                result << "Upstream job: ${c.getUpstreamProject()} #${c.getUpstreamBuild()}"
                break
            case c instanceof org.jenkinsci.plugins.workflow.support.steps.build.RunWrapper:
                return 'Outro job'
                break
            default:
                result << c.toString()
                break
        }
    }
    return (result.unique()).join('  |  ')
}


/*--------------------------------------------------
    Criação e inicializa o arquivo de log da execução
--------------------------------------------------*/
@NonCPS
void createLog(Map args) {
    // Verifica se deve criar o log
    if (!log.create) {
        return
    }
    
    // Extrai os parâmetros nomeados do Map.
    //String action      = args.action ?: 'deploy' // Para definir um valor padrão
    String action      = args.action
    String database    = args.database
    String username    = args.username
    String tag         = args.tag
    String buildNumber = args.buildNumber
    String jobName     = args.jobName
    String workspace   = args.workspace

    String timestamp = new Date().format('yyyyMMdd_HHmmss')

    // Diretório de criação do log
    log.path = "log"
    // Nome do arquivo do log
    log.name = "${action}__${tag}__${database}__${timestamp}__${buildNumber}.log"
    // Inicializa o handle com o diretório absoluto do workspace e o nome do arquivo
    log.handle = new File("${workspace}/${log.path}/${log.name}")
    // Obtém o diretório pai do handle
    File path = log.handle.getParentFile()
    //java.io.File path = log.handle.getParentFile()

    // Cria diretório se não existir
    if (!path.isDirectory()) {
        boolean created = path.mkdirs()
        // Testa o retorno da criação do diretório
        if (!created) {
            throw new Exception("Falha ao criar o diretório do log: ${path.absolutePath}")
        }
    }

    // Prepara o cabeçalho
    log.text = [
        '------------------------------',
        "Username : ${username}",
        "Tag      : ${tag}",
        "Database : ${database}",
        "Build #  : ${buildNumber}",
        "Job Name : ${jobName}",
        "WorkSpace: ${workspace}",
        "Timestamp: ${timestamp}",
        '------------------------------',
        '',
        ''
    ]

    // Cria o arquivo e grava o cabeçalho
    log.handle.withWriter('UTF-8') { writer -> // Cria o arquivo
        writer.writeLine(log.text.join('\n'))  // Adiciona o cabeçalho
    }

    // Limpa a variável de bloco após a escrita
    log.text.clear()
}


/*--------------------------------------------------
    Adição de uma linha única ao buffer do log
--------------------------------------------------*/
void addLogLine(String line) {
    if (!log.create ||
        !log.handle ||
        !line) {
        return
    }

    // Adiciona a linha ao buffer
    String now = new Date().format('HH:mm:ss')
    log.buffer << "[${now}] ${line}"
}


/*--------------------------------------------------
    Inclusão de uma linha ao bloco de texto do log
--------------------------------------------------*/
void addLogTextLine(String line) {
    if (!log.create ||
        !log.handle ||
        !line) {
        return
    }

    // Adiciona a linha ao bloco de texto
    log.text << "    ${line}"
}


/*--------------------------------------------------
    Flush do bloco de texto ao buffer do log
--------------------------------------------------*/
void flushLogText() {
    if (!log.create ||
        !log.handle) {
        return
    }

    // Adiciona o bloco de texto ao buffer
    String now = new Date().format('HH:mm:ss')
    log.buffer << "[${now}]"
    log.text.each { line ->
        log.buffer << line
    }

    // Limpa o buffer após adicionar
    log.text.clear()
}


/*--------------------------------------------------
    Grava o conteúdo do buffer no arquivo de log e limpa o buffer
--------------------------------------------------*/
@NonCPS
void flushLog() {
    if (!log.create ||
        !log.handle ||
        !log.buffer) {
        return
    }

    // Descarrega o buffer
    log.handle.withWriterAppend('UTF-8') { writer -> // adiciona no arquivo
        writer.writeLine(log.buffer.join('\n'))
    }

    // Limpa o buffer após flush
    log.buffer.clear()
}


/*--------------------------------------------------
    Encerramento do arquivo de log
--------------------------------------------------*/
@NonCPS
void finishLog(Map args) {
    if (!log.create ||
        !log.handle) {
        return
    }

    // Extrai os parâmetros nomeados do Map.
    //def action             = args.action ?: 'deploy' // Para definir um valor padrão
    String action          = args.action
    String database        = args.database
    String tag             = args.tag
    String buildNumber     = args.buildNumber
    String status          = args.status
    boolean packageParcial = args.packageParcial

    String timestamp = new Date().format('yyyyMMdd_HHmmss')

    // Prepara a finalização
    log.text = [
        '',
        '',
        '------------------------------',
        "${action} terminado com ${status}"
    ]
    if (packageParcial) {
        log.text << 'Package criada parcialmente'
    }
    log.text << "Database : ${database}"
    log.text << "Tag      : ${tag}"
    log.text << "Build #  : ${buildNumber}"
    log.text << "Timestamp: ${timestamp}"
    log.text << '------------------------------'

    // Descarrega o texto
    log.handle.withWriterAppend('UTF-8') { writer ->  // Acessa o arquivo
        writer.writeLine(log.text.join('\n')) // Adiciona a finalização
    }

    // Limpa as variáveis após a finalização
    log.handle = null
    log.text.clear()
    log.buffer.clear()
}


return this
