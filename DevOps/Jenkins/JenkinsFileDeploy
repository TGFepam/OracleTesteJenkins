// Variável para o arquivo da biblioteca
def lib

// Variáveis para os objetos JSON
Map jsonConf // Parâmetros de configuração
Map jsonData // Informações dos bancos de dados
Map jsonPlan // Planejamento do deploy
Map jsonRevt // Planejamento do revert

// Indica a consistência do plano de revert
boolean consistRevert = false

// Variável para os dados do database
Map database = [
    descricao  : '',
    enderecoIP : '',
    porta      : '',
    serviceName: '',
    conexao    : ''
]

Map acao = [
    matarSessoes     : [
        executar: false,
        script  : ''
    ],
    listarInvalidos  : [
        executar: false,
        script  : ''
    ],
    recompilarObjetos: [
        executar: false,
        script  : ''
    ]
]

// Variável para armazenar o diretório raiz do repositório
String diretorioRaiz = ''

// Variável para display de texto em bloco
List<String> texto = []

// Variável com o alerta de package criada parcialmente
boolean packageParcial = false


pipeline {
    agent any
    environment {
        // Credencial de conexão com o banco de dados
        DB_CONN = credentials('DevOps_DB')
    }

    options {
        // Altera o funcionamento default e não faz o checkout do SCM no início do build
        skipDefaultCheckout(true)
        // Descarta os logs de builds deixando os últimos 20
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {

        stage('Limpa Workspace') {
            steps {
                script {
                    echo 'Limpando Workspace antes do checkout'
                    cleanWs() // Limpa resíduos de builds antigos
                } //Script 
            } // Steps
        } // Stage 'Preparação'


        stage('Checkout Repositório') {
            steps {
                script {
                    echo 'Realizando Checkout do Repositório'

                    // Verifica se o parâmetro Tag foi selecionado
                    if (Tag == 'None' || Tag.trim().isEmpty()) {
                        error 'É necessário selecionar uma Tag para o checkout do repositório e deploy!'
                    }

                    echo "Realizando checkout da Tag: ${Tag}"
                    checkout scm: ([
                        $class: 'GitSCM',
                        branches: [[name: Tag]],
                        userRemoteConfigs: scm.userRemoteConfigs,
                        extensions: scm.extensions
                    ])
                    echo 'Checkout do Repositório Concluído'
                } // script
            } // Steps
        } // stage 'Checkout Repositório'


        stage('Inicia Processo') {
            steps {
                script {
                    echo 'Início do Processo e Carga das Configurações'

                    echo 'Carrega a biblioteca'
                    try {
                        lib = load 'DevOps/Jenkins/LibraryFile'
                    } catch (Exception e) {
                        // Erro crítico: coloca na console e aborta
                        echo "Falha carregando a biblioteca (DevOps/Jenkins/LibraryFile):\n${e.getMessage()}"
                        error "Falha carregando a biblioteca"
                    }

                    // Nome do arquivo de config
                    String confFile = 'DevOps/Jenkins/ConfigParam.json'
                    echo "Processa arquivo JSON de parâmetros de configuração: ${confFile}"

                    // Verifica se o arquivo JSON existe, se está válido e com dados
                    try {
                        jsonConf = lib.parseJSON(confFile, 'dos parâmetros de configuração')
                    } catch (Exception e) {
                        echo lib.status('E', "Arquivo JSON de configuração não pode ser carregado:\n${e.getMessage()}")
                        error lib.status('E', 'Falha lendo/parseando arquivos JSON de configuração')
                    }

                    // Inicializa a variável que determina a criação do log da biblioteca
                    lib.log.create = jsonConf.createLog

                    if (!lib.log.create) {
                        lib.log.create = false
                    }

                    // Verifica se o parâmetro Database foi selecionado
                    if (Database == 'none' || Database.trim().isEmpty()) {
                        error 'Banco de dados de destino para o deploy não selecionado!'
                    }

                    if (lib.log.create) {
                        echo 'Cria arquivo de log do deploy'
                        try {
                            lib.createLog(
                                action     : 'deploy',
                                database   : Database,
                                username   : lib.getBuildStarter(),
                                tag        : Tag,
                                buildNumber: env.BUILD_NUMBER,
                                jobName    : env.JOB_NAME,
                                workspace  : env.WORKSPACE
                            )
                        } catch (Exception e) {
                            echo lib.status('A', "Arquivo de log do deploy não pode ser criado:\n${e.getMessage()}")
                            lib.log.create = false
                        }
                    }

                    // Carrega o indicativo da consistência do revert
                    consistRevert = jsonConf.consistRevert

                    echo 'Início do Processo e Carga das Configurações Concluídos'
                } // script
            } // steps
        } // stage 'Inicia Processo'


        stage('Carrega JSONs') {
            steps {
                script {
                    echo lib.line('Início da Carga dos Arquivos JSON do Banco de Dados e Planejamento')

                    // Nome dos arquivos
                    String dataFile = 'DevOps/Jenkins/DatabaseParam.json'
                    String planFile = "DevOps/Plannings/Planning_Deploy.json"
                    String revtFile = "DevOps/Plannings/Planning_Revert.json"

                    texto = [
                        lib.text('Arquivos JSON'),
                        lib.text("Banco de Dados: ${dataFile}"),
                        lib.text("Planejamento do Deploy: ${planFile}")
                    ]

                    if (consistRevert) {
                        texto << lib.text("Planejamento do Revert: ${revtFile}")
                    }
                    echo lib.writeText(texto)

                    // Verifica se os arquivos JSON existem, se estão válidos e com dados
                    try {
                        jsonData = lib.parseJSON(dataFile, 'do banco de dados')
                        jsonPlan = lib.parseJSON(planFile, 'do planejamento para o deploy')

                        if (consistRevert) {
                            jsonRevt = lib.parseJSON(revtFile, 'do planejamento para o revert')
                        }
                    } catch (Exception e) {
                        echo lib.status('E', "Não foi possível ler/parsear os arquivos JSON:\n${e.getMessage()}")
                        error 'Falha lendo/parseando arquivos JSON'
                    }
                    echo lib.line('Final da Carga dos Arquivos JSON do Banco de Dados e Planejamento')
                } // script
            } // steps
        } // stage 'Carrega JSONs'


        stage('Processa Parâmetros') {
            steps {
                script {
                    echo lib.line('Início do Processamento dos Parâmetros do Planejamento Para Deploy')
                    String usuario

                    // Valida a Tag selecionada com a Tag do planejamento
                    if (jsonPlan.tag != Tag) {
                        error lib.status('E', "Tag do planejamento ${jsonPlan.tag} é diferente da tag parametrizada ${Tag}")
                    }

                    if (consistRevert) {
                        if (jsonRevt.tag != Tag) {
                            error lib.status('E', "Tag do planejamento de Revert ${jsonRevt.tag} é diferente da tag parametrizada ${Tag}")
                        }
                    }

                    // Variável para armazenar o diretório raiz do repositório
                    diretorioRaiz = jsonConf.rootDirectories.deploy

                    // Dados do database
                    database.descricao   = jsonData[Database].descricao
                    database.enderecoIP  = jsonData[Database].enderecoIP
                    database.porta       = jsonData[Database].porta
                    database.serviceName = jsonData[Database].serviceName

                    database.conexao = "$DB_CONN_USR/$DB_CONN_PSW@${database.enderecoIP}:${database.porta}/${database.serviceName}"

                    // Descrição do build
                    usuario = jsonPlan.autor.trim().split()[0] // Primeiro nome do analista
                    currentBuild.description = "Tag: ${Tag} | Usr: ${usuario} | DB: ${database.descricao}"

                    texto = [
                        lib.text('Parâmetros de Execução do Build'),
                        lib.text("Tag: ${Tag}"),
                        lib.text("Database: ${database.descricao}"),
                        lib.text(''),
                        lib.text('Dados do Build'),
                        lib.text("Username: ${lib.getBuildStarter()}"),
                        lib.text("Build #: ${env.BUILD_NUMBER}"),
                        lib.text("Job Name: ${env.JOB_NAME}"),
                        lib.text("Workspace: ${env.WORKSPACE}")
                    ]
                    echo lib.writeText(texto)

                    // Mensagem de alerta para database de produção
                    if (Database == 'fprod') {
                        texto = [
                            lib.text(''),
                            lib.text('------------------------------'),
                            lib.text('          ATENÇÃO             '),
                            lib.text('Deploy no database de produção'),
                            lib.text('------------------------------'),
                            lib.text('')
                        ]
                        echo lib.writeText(texto)
                    }

                    // Inicializa o nome dos scripts das ações
                    acao.matarSessoes.script      = jsonConf.scripts.killSessions
                    acao.listarInvalidos.script   = jsonConf.scripts.listInvalids
                    acao.recompilarObjetos.script = jsonConf.scripts.compileObjects

                    // Ações planejadas
                    acao.matarSessoes.executar      = jsonPlan.acoes.matarSessoes
                    acao.listarInvalidos.executar   = jsonPlan.acoes.listarInvalidos
                    acao.recompilarObjetos.executar = jsonPlan.acoes.recompilarObjetos

                    texto = [
                        lib.text(''),
                        lib.text('Informações do Planejamento'),
                        lib.text("Autor: ${jsonPlan.autor}"),
                        lib.text("Data: ${jsonPlan.data}"),
                        lib.text("Descrição: ${jsonPlan.descricao}"),
                        lib.text("Tag: ${jsonPlan.tag}"),
                        lib.text(''),
                        lib.text('Ações Planejadas'),
                        lib.text("Matar sessões: ${jsonPlan.acoes.matarSessoes ? 'SIM' : 'NÃO'}"),
                        lib.text("Listar inválidos: ${jsonPlan.acoes.listarInvalidos ? 'SIM' : 'NÃO'}"),
                        lib.text("Recompilar objetos: ${jsonPlan.acoes.recompilarObjetos ? 'SIM' : 'NÃO'}"),
                        lib.text(''),
                        lib.text('Database'),
                        lib.text("Destino: ${database.descricao}"),
                        lib.text("Endereço IP: ${database.enderecoIP}"),
                        lib.text("Porta: ${database.porta}"),
                        lib.text("Service name: ${database.serviceName}"),
                        lib.text('')
                    ]
                    echo lib.writeText(texto)

                    // Verifica ações ativas
                    if (!jsonPlan.acoes.matarSessoes &&
                        !jsonPlan.acoes.listarInvalidos &&
                        !jsonPlan.acoes.recompilarObjetos) {
                        echo lib.status('A', 'Nenhuma ação adicional planejada')
                    }
                    echo lib.line('Final do Processamento dos Parâmetros do Planejamento Para Deploy')
                } // script
            } // steps
        } // stage 'Processa Parâmetros'


        stage('Valida Objetos') {
            steps {
                script {
                    echo lib.line('Início da Validação dos Objetos Planejados Para Deploy')

                    jsonPlan.objetos.each { obj ->
                        echo lib.line("Verifica a existência do script: ${diretorioRaiz}/${obj.nome}")
                        if (!fileExists(file: "${diretorioRaiz}/${obj.nome}")) {
                            error lib.status('E', "Script ${diretorioRaiz}/${obj.nome} programado para deploy não encontrado")
                        }
                        echo lib.line("Script: ${diretorioRaiz}/${obj.nome}")

                        echo lib.line('Verifica encoding do script')
                        lib.validateScriptEncoding("${diretorioRaiz}/${obj.nome}")

                        if (jsonConf.validateScript[Database]) {
                            echo lib.line('Verifica caracteres inválidos no script')
                            lib.validateScriptCharacters("${diretorioRaiz}/${obj.nome}")
                        }
                    }
                    if (!jsonConf.validateScript[Database]) {
                        echo lib.status('A', 'Verificação de caracteres inválidos no script está desabilitada nos parâmetros')
                    }
                    echo lib.line('Final da Validação dos Objetos Planejados Para Deploy')
                } // script
            } // steps
        } // stage 'Valida Objetos'


        stage('Mata Sessões') {
            steps {
                script {
                    if (!acao.matarSessoes.executar) {
                        echo lib.status('A', 'Matar as sessões do banco de dados antes do deploy está inativa no planejamento - nenhuma ação foi executada')
                        return
                    }
                    echo lib.status('A', 'Mata as Sessões do Banco de Dados Antes do Deploy')
                    String script = acao.matarSessoes.script
                    String retorno

                    echo lib.line("Verificando Script: ${script}")

                    if (!fileExists(file: script)) {
                        error lib.status('E', "Script ${script} para matar as sessões antes do deploy não encontrado")
                    }

                    // Executa o script
                    retorno = lib.runScript(script, database.conexao)
                    echo lib.line("Retorno da execução:\n${retorno}")

                    if (retorno.toUpperCase().contains('ERROR')) {
                        error lib.status('E', 'Script que mata as sessões do banco de dados antes do deploy está com erro')
                    } else if (!retorno.toUpperCase().contains('COMPLETED')) {
                        error lib.status('E', 'Script que mata as sessões do banco de dados antes do deploy não executou')
                    }

                    echo lib.line('Final do Script que Mata as Sessões do Banco de Dados Antes do Deploy')
                } // script
            } // steps
        } // stage 'Mata Sessões'


        stage('Deploy') {
            steps {
                script {
                    echo lib.line("Início do Deploy dos Objetos Planejados no Banco ${database.descricao}")
                    String tipoObjeto
                    String retorno

                    jsonPlan.objetos.each { obj ->
                        tipoObjeto = obj.nome.split('/')[0][0..-2].toLowerCase()

                        texto = [
                            lib.text("Arquivo: ${diretorioRaiz}/${obj.nome}"),
                            lib.text("Descrição: ${obj.descricao}")
                        ]
                        echo lib.writeText(texto)

                        // Executa o script
                        retorno = lib.runScript("${diretorioRaiz}/${obj.nome}", database.conexao, tipoObjeto)
                        echo lib.line("Retorno da execução:\n${retorno}")

                        retorno = retorno.toUpperCase()
                        // Se o retorno contém "error", valida os objetos com check de erros
                        if (retorno.contains('ERROR')) {
                            // Se o tipo do objeto estiver na lista de check, retorno deve conter "No errors."
                            if (tipoObjeto in lib.checkErrors) {
                                // Se não contém, é erro
                                if (!retorno.contains('NO ERRORS.')) {
                                    error lib.status('E', "Erro aplicando ${obj.nome} - Deploy abortado!")
                                }
                            } else { // Se contém "ERROR" e não é objeto com check, também é erro
                                error lib.status('E', "Erro aplicando ${obj.nome} - Deploy abortado!")
                            }
                        }

                        // Se não gerou o erro acima, testa se teve sucesso na execução do script
                        switch (true) {
                            case retorno.contains('CREATED'):
                                // O retorno CREATED também é para packages. Se for o caso, alerta para criação apenas da specification ou apenas do body.
                                if (tipoObjeto == 'package') {
                                    if (retorno.contains('PACKAGE CREATED.')) {
                                        if (retorno.contains('PACKAGE BODY CREATED.')) {
                                            echo lib.status('S', "${obj.nome} criado")
                                            packageParcial = false
                                        } else {
                                            echo lib.status('A', "${obj.nome} criado parcialmente - apenas a specification")
                                            packageParcial = true
                                        }
                                    } else {
                                        if (retorno.contains('PACKAGE BODY CREATED.')) {
                                            echo lib.status('A', "${obj.nome} criado parcialmente - apenas o body")
                                            packageParcial = true
                                        }
                                    }
                                } else {
                                    echo lib.status('S', "${obj.nome} criado")
                                }
                                break
                            case retorno.contains('ALTERED'):
                                echo lib.status('S', "${obj.nome} alterado")
                                break
                            case retorno.contains('COMPLETED'):
                                echo lib.status('S', "${obj.nome} executado")
                                break
                            default:
                                echo lib.status('S', 'Processo concluído')
                                break
                        }
                    }
                    echo lib.line("Final do Deploy dos Objetos Planejados no Banco ${database.descricao}")
                } // script
            } // steps
        } // stage 'Deploy'


        stage('Lista Inválidos') {
            steps {
                script {
                    if (!acao.listarInvalidos.executar) {
                        echo lib.status('A', 'Listagem de objetos inválidos após o deploy está inativa no planejamento - nenhuma ação foi executada')
                        return
                    }
                    echo lib.line('Lista Objetos Inválidos Após o Deploy')
                    String script = acao.listarInvalidos.script
                    String retorno

                    echo lib.line("Verificando script: ${script}")

                    if (!fileExists(file: script)) {
                        error lib.status('E', "Script ${script} para listar objetos inválidos após o deploy não encontrado")
                    }

                    // Executa o script
                    retorno = lib.runScript(script, database.conexao)
                    echo lib.line("Retorno da execução:\n${retorno}")

                    if (retorno.toUpperCase().contains('ERROR')) {
                        error lib.status('E', 'Script que lista objetos inválidos após o deploy está com erro')
                    } else if (!retorno.toUpperCase().contains('COMPLETED')) {
                        error lib.status('E', 'Script que lista objetos inválidos após o deploy não executou')
                    }

                    echo lib.line('Final do Script que Lista os Objetos Inválidos Após o Deploy')
                } // script
            } // steps
        } // stage 'Lista Inválidos'


        stage('Recompila Objetos') {
            steps {
                script {
                    if (!acao.recompilarObjetos.executar) {
                        echo lib.status('A', 'Recompilação de objetos após o deploy está inativa no planejamento - nenhuma ação foi executada')
                        return
                    }
                    echo lib.line('Recompila Objetos Após o Deploy')
                    String script = acao.recompilarObjetos.script
                    String retorno

                    echo lib.line("Verificando script: ${script}")

                    if (!fileExists(file: script)) {
                        error lib.status('E', "Script ${script} para recompilar objetos inválidos após o deploy não encontrado")
                    }

                    // Executa o script
                    retorno = lib.runScript(script, database.conexao)
                    echo lib.line("Retorno da execução:\n${retorno}")

                    if (retorno.toUpperCase().contains('ERROR')) {
                        error lib.status('E', 'Script que recompila objetos após o deploy está com erro')
                    } else if (!retorno.toUpperCase().contains('COMPLETED')) {
                        error lib.status('E', 'Script que recompila objetos após o deploy não executou')
                    }

                    echo lib.line('Final do Script que Recompila os Objetos Após o Deploy')
                } // script
            } // steps
        } // stage 'Recompila Objetos'

    } // stages


    post {
        always {
            script {
                String status
                if (lib.log.create) {
                    echo 'Finaliza o log e arquiva nos artefatos do build'

                    if (packageParcial) {
                        status = 'alerta'
                    } else {
                        if (currentBuild.result == 'SUCCESS') {
                            status = 'sucesso'
                        } else if (currentBuild.result == 'UNSTABLE') {
                            status = 'alerta'
                        } else if (currentBuild.result == 'FAILURE') {
                            status = 'erro'
                        } else {
                            status = 'status indefinido'
                        }
                    }

                    // Verifica fisicamente se o arquivo foi criado no workspace
                    if (fileExists("${lib.log.path}/${lib.log.name}")) {
                        lib.flushLog()
                        lib.finishLog(
                            action        : 'Deploy',
                            database      : Database,
                            tag           : Tag,
                            buildNumber   : env.BUILD_NUMBER,
                            status        : status,
                            packageParcial: packageParcial
                        )
                        archiveArtifacts artifacts: "${lib.log.path}/${lib.log.name}", fingerprint: true, onlyIfSuccessful: false, allowEmptyArchive: true

                        echo "Log ${lib.log.name} do deploy disponível nos artefatos do build"
                    } else {
                        echo "Falha no arquivamento do log do deploy: O arquivo ${lib.log.name} não foi encontrado no Workspace"
                    }
                    // Limpa o nome do log após o arquivamento
                    lib.log.path = null
                    lib.log.name = null
                } else {
                    echo 'Arquivo de log do deploy não foi criado'
                }
                echo 'Limpando a Workspace após o deploy com sucesso'
                if (status == 'sucesso') {
                    cleanWs() // Limpa resíduos de builds antigos
                }
            } // script
        } // always
    } // post

} // pipeline
